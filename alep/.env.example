# Public client-side values from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public VAPID key for admin PWA push notifications (never put the private key here).
VITE_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
